h1 Задизайнено

//- div.tags ну типа фильтр, рубрикатор и тд. Потом придумаю че сюда воткнуть

div.projects
    each project in collections.projects
        a.project(href=project.url, class=project.data.big ? "project-big" : null)
            if project.data.cover
                if /\.(mp4|webm|mov)$/.test(project.data.cover)
                    video(src=project.data.cover, autoplay, muted, loop, playsinline)
                else
                    img(src=project.data.cover, alt="")
            p.caption= project.data.title
